---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import CategoryPills from "../../components/CategoryPills.astro";
import { ICONS } from "../../lib/icons";

const recipes = (await getCollection("recipes")).sort(
  (a, b) => b.data.date_added.valueOf() - a.data.date_added.valueOf()
);
---

<BaseLayout title="Toutes les recettes — Mes Recettes Bernon">
  <h1>Toutes les recettes</h1>
  <p>{recipes.length} recettes au total. Filtrez par catégorie ou cherchez par nom.</p>

  <div class="recipe-toolbar">
    <CategoryPills />

    <div class="sort-control">
      <button
        type="button"
        id="sort-toggle"
        class="icon-btn"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="sort-menu"
        aria-label="Trier les recettes"
      >
        <span class="icon" set:html={ICONS.sort} />
      </button>
      <div class="sort-menu" id="sort-menu" role="menu" hidden>
        <button type="button" class="sort-option" role="menuitem" data-sort-value="date">Date d'ajout</button>
        <button type="button" class="sort-option" role="menuitem" data-sort-value="alpha">Ordre alphabétique</button>
        <button type="button" class="sort-option" role="menuitem" data-sort-value="category">Catégorie</button>
      </div>
    </div>
  </div>

  <p class="search-empty" id="search-empty">Aucune recette ne correspond à votre recherche.</p>

  <div class="recipe-grid" id="recipe-grid">
    {recipes.map((recipe) => (
      <RecipeCard recipe={recipe} />
    ))}
  </div>
</BaseLayout>

<script>
  // The header search box (in BaseLayout) is now the only search input on the
  // site. On this page it live-filters the grid instead of navigating.
  const input = document.getElementById("nav-search-input") as HTMLInputElement | null;
  const sortToggle = document.getElementById("sort-toggle") as HTMLButtonElement | null;
  const sortMenu = document.getElementById("sort-menu") as HTMLElement | null;
  const sortOptions = Array.from(document.querySelectorAll<HTMLButtonElement>(".sort-option"));
  const emptyMessage = document.getElementById("search-empty");
  const grid = document.getElementById("recipe-grid");
  const pills = Array.from(document.querySelectorAll<HTMLElement>("[data-category-pill]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".recipe-card"));

  // Same category order as the filter pills, used to group the "Catégorie" sort.
  const categoryOrder = ["Entrées", "Tartes & Salades", "Plats", "Desserts", "Préparations"];

  let activeCategory = "all";
  let activeSort = "date";

  function sortCards(list: HTMLElement[]) {
    const sorted = [...list];
    sorted.sort((a, b) => {
      if (activeSort === "alpha") {
        return (a.dataset.title || "").localeCompare(b.dataset.title || "", "fr");
      }
      if (activeSort === "category") {
        const aIndex = categoryOrder.indexOf(a.dataset.category || "");
        const bIndex = categoryOrder.indexOf(b.dataset.category || "");
        if (aIndex !== bIndex) return aIndex - bIndex;
        return (a.dataset.title || "").localeCompare(b.dataset.title || "", "fr");
      }
      // "date" (default): most recently added first.
      return Number(b.dataset.date || 0) - Number(a.dataset.date || 0);
    });
    return sorted;
  }

  function applyFilters() {
    const query = (input?.value || "").trim().toLowerCase();
    let visibleCount = 0;

    const ordered = sortCards(cards);
    ordered.forEach((card) => {
      grid?.appendChild(card);

      const title = card.dataset.title || "";
      const ingredientsText = card.dataset.ingredients || "";
      const category = card.dataset.category || "";
      const matchesCategory = activeCategory === "all" || category === activeCategory;
      const matchesQuery = !query || title.includes(query) || ingredientsText.includes(query);
      const show = matchesCategory && matchesQuery;
      card.style.display = show ? "" : "none";
      if (show) visibleCount++;
    });

    if (emptyMessage) {
      emptyMessage.style.display = visibleCount === 0 ? "block" : "none";
    }
  }

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => {
        p.classList.remove("active");
        p.setAttribute("aria-pressed", "false");
      });
      pill.classList.add("active");
      pill.setAttribute("aria-pressed", "true");
      activeCategory = pill.dataset.categoryPill || "all";
      applyFilters();
    });
  });

  if (input) {
    input.addEventListener("input", applyFilters);
  }

  function closeSortMenu() {
    if (!sortMenu || !sortToggle) return;
    sortMenu.hidden = true;
    sortToggle.setAttribute("aria-expanded", "false");
  }

  function openSortMenu() {
    if (!sortMenu || !sortToggle) return;
    sortMenu.hidden = false;
    sortToggle.setAttribute("aria-expanded", "true");
    // Default anchor is the button's right edge. On narrow screens the
    // button can end up near the left edge of the viewport, which would
    // push the menu off-screen — flip to the button's left edge instead.
    sortMenu.style.left = "";
    sortMenu.style.right = "0";
    const rect = sortMenu.getBoundingClientRect();
    if (rect.left < 8) {
      sortMenu.style.right = "";
      sortMenu.style.left = "0";
    }
  }

  if (sortToggle && sortMenu) {
    sortToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      if (sortMenu.hidden) {
        openSortMenu();
      } else {
        closeSortMenu();
      }
    });

    document.addEventListener("click", (event) => {
      if (!sortMenu.hidden && !sortMenu.contains(event.target as Node) && event.target !== sortToggle) {
        closeSortMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !sortMenu.hidden) {
        closeSortMenu();
        sortToggle.focus();
      }
    });
  }

  sortOptions.forEach((option) => {
    option.addEventListener("click", () => {
      activeSort = option.dataset.sortValue || "date";
      closeSortMenu();
      applyFilters();
    });
  });

  // Landed here via the header search (e.g. /recettes/?q=...) — reflect it
  // into the header input and apply it as the active filter immediately.
  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get("q");
  if (initialQuery && input) {
    input.value = initialQuery;
  }

  applyFilters();
</script>
