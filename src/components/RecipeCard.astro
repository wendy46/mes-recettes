---
import type { CollectionEntry } from "astro:content";
import { getRecipeImage } from "../utils/images";
import { ICONS } from "../lib/icons";
import { TAG_LABELS } from "../lib/subtags";

interface Props {
  recipe: CollectionEntry<"recipes">;
}

const { recipe } = Astro.props;
const { title, subtitle, category, servings, prep_time, cook_time, image, date_added, ingredients, tags } = recipe.data;
const imgSrc = getRecipeImage(recipe.slug, category, image);

// Compact meta line: prep time (or cook time when no prep time is given) + servings.
const time = prep_time ?? cook_time;
const people = servings?.replace(/\bpersonnes?\b/i, "pers.");
---

<a
  class="recipe-card"
  href={`/recettes/${recipe.slug}/`}
  data-title={title.toLowerCase()}
  data-ingredients={ingredients.join(" ").toLowerCase()}
  data-category={category}
  data-tags={tags.join(" ")}
  data-date={date_added.getTime()}
>
  <div class="recipe-card-media">
    <img src={imgSrc} alt={title} loading="lazy" />
    <div class="photo-badges">
      <span class="badge">{category}</span>
      {tags.filter((tag) => TAG_LABELS[tag]).map((tag) => (
        <span class="badge badge-sub">{TAG_LABELS[tag]}</span>
      ))}
    </div>
  </div>
  <div class="recipe-card-body">
    <h3>{title}</h3>
    {subtitle && <p class="recipe-card-subtitle">{subtitle}</p>}
    {(time || people) && (
      <div class="recipe-card-meta">
        {time && (
          <span class="recipe-card-meta-item">
            <span class="icon" set:html={ICONS.clock} />
            {time}
          </span>
        )}
        {people && (
          <span class="recipe-card-meta-item">
            <span class="icon" set:html={ICONS.users} />
            {people}
          </span>
        )}
      </div>
    )}
  </div>
</a>
