---
import type { CollectionEntry } from "astro:content";
import { getRecipeImage } from "../utils/images";
import { ICONS } from "../lib/icons";

interface Props {
  recipe: CollectionEntry<"recipes">;
}

const { recipe } = Astro.props;
const { title, category, servings, prep_time, cook_time, image, date_added, ingredients } = recipe.data;
const imgSrc = getRecipeImage(recipe.slug, category, image);
---

<a
  class="recipe-card"
  href={`/recettes/${recipe.slug}/`}
  data-title={title.toLowerCase()}
  data-ingredients={ingredients.join(" ").toLowerCase()}
  data-category={category}
  data-date={date_added.getTime()}
>
  <div class="recipe-card-media">
    <img src={imgSrc} alt={title} loading="lazy" />
    <span class="badge recipe-card-badge">{category}</span>
  </div>
  <div class="recipe-card-body">
    <h3>{title}</h3>
    {(servings || prep_time || cook_time) && (
      <div class="recipe-card-meta">
        {servings && <span>Pour {servings}</span>}
        {prep_time && <span>Préparation : {prep_time}</span>}
        {cook_time && <span>Cuisson : {cook_time}</span>}
      </div>
    )}
    <span class="btn btn-dark recipe-card-cta">
      Voir la recette
      <span class="icon" set:html={ICONS.arrowRight} />
    </span>
  </div>
</a>
